{
  "name": "@exccoder/dsh-media-workbench",
  "version": "0.2.2",
  "description": "DeepSeek Harness 插件「摩登-媒体工作室」：生图、写作、星图、视频四个工作台，带本机作品库与星图 DAG 编排。",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "web",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "icon": "./web/favicon.svg",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "creative-studio",
    "modern-media",
    "media-studio",
    "image-generation",
    "writing",
    "video",
    "storyboard",
    "workflow",
    "dag",
    "constellation"
  ],
  "license": "MIT",
  "author": "ExcCoder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExcCoder/modern-dsh-media-workbench.git"
  },
  "homepage": "https://github.com/ExcCoder/modern-dsh-media-workbench#readme",
  "bugs": {
    "url": "https://github.com/ExcCoder/modern-dsh-media-workbench/issues"
  },
  "scripts": {
    "dev": "node tools/dev-server.mjs",
    "verify": "node --test tools/verify.mjs",
    "test": "node --test tools/verify.mjs",
    "pack": "npm pack"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
